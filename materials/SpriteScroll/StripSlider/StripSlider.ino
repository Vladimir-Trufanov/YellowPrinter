// StripSlider.ino - прототип полосы прокрутки и кнопки для YellowPrinter

#include <TFT_eSPI.h>

TFT_eSPI tft = TFT_eSPI();

void setup() 
{
  tft.init();
  tft.fillScreen(TFT_BLACK); // clear the screen
  // Set the TFT display rotation in landscape mode
  tft.setRotation(1);
}

void loop() 
{
  /*
  Рисуем сглаженный (anti-aliased) прямоугольник с закруглёнными углами. 
  
  Синтаксис
  void drawSmoothRoundRect(int32_t x, int32_t y, int32_t r, int32_t ir, int32_t w, int32_t h, uint32_t fg_color, uint32_t bg_color = 0x00FFFFFF, uint8_t quadrants = 0xF);
  
  Параметры
  x, y — координаты верхнего левого угла прямоугольника на экране.
  r — радиус скругления вертикальных сторон.
  ir — радиус скругления горизонтальных сторон.
  w, h — ширина и высота прямоугольника соответственно.
  fg_color — цвет контура фигуры (передний план).
  bg_color — цвет фона (опционально, по умолчанию — белый 0x00FFFFFF).
  quadrants — битовая маска, которая определяет, какие части прямоугольника будут сглажены (по умолчанию рисуются все четыре дуги).

  В отличие от обычной функции drawRoundRect(), которая просто рисует контур, 
  drawSmoothRoundRect() создаёт более плавный и аккуратный вид за счёт сглаживания пикселей на границах фигуры. 
  
  Пример
  tft.drawSmoothRoundRect(10, 70, 10, 5, 50, 90, TFT_RED, TFT_BLACK);
  Здесь прямоугольник будет нарисован в точке (10, 70), с вертикальным радиусом 10, 
  горизонтальным 5, шириной 50 и высотой 90. Цвет контура — красный, фон — чёрный. 
  
  Особенности
  Сглаживание делает края фигуры плавными, устраняя «лесенку», что особенно заметно на текстах или иконках.
  Маска quadrants позволяет контролировать, какие дуги (верхняя, нижняя, левая, правая) будут сглажены.
  Это полезно для создания сложных эффектов.
  Если вам нужно не просто нарисовать контур, а заполнить фигуру цветом, в библиотеке есть родственный метод fillSmoothRoundRect() 
  */
  
  /*
  Функция fillSmoothRoundRect() в библиотеке TFT_eSPI предназначена для рисования и заливки заполненного прямоугольника со скруглёнными углами 
  с антиалиасингом (сглаживанием). Это значит, что края фигуры будут выглядеть плавными, а не «лесенчатыми», что делает интерфейс 
  более профессиональным. 

  Как работает сглаживание. При антиалиасинге функция не просто закрашивает пиксели, а рассчитывает промежуточные
  оттенки на границе фигуры. Это достигается за счёт использования дополнительного фонового цвета (bg_color), который 
  задаётся как второй параметр. Если этот параметр не указать, функция попытается прочитать цвет пикселя непосредственно
  из дисплея (TFT или спрайта). 
  
  Синтаксис:
  void fillSmoothRoundRect(int32_t x, int32_t y, int32_t w, int32_t h, int32_t radius, uint32_t color, uint32_t bg_color = 0x00FFFFFF);
  Параметры:
  x, y — координаты верхнего левого угла прямоугольника.
  w, h — ширина и высота прямоугольника.
  radius — радиус скругления углов.
  color — цвет заливки (передний план).
  bg_color — цвет фона (опционально, по умолчанию 0x00FFFFFF).
  Пример использования:
  Рисуем сглаженный прямоугольник размером 100x100 пикселей с радиусом скругления 10 пикселей,
  залитый жёлтым цветом на чёрном фоне
  tft.fillSmoothRoundRect(10, 10, 100, 100, 10, TFT_YELLOW, TFT_BLACK);

  Важные нюансы. Производительность. Антиалиасинг требует дополнительных вычислений, поэтому 
  на дисплеях с ограниченными ресурсами (особенно на микроконтроллерах вроде ESP32) 
  эта операция может быть медленнее, чем обычная заливка.
  Зависимость от фона. Для корректной работы сглаживания важно, чтобы был задан фоновый цвет. 
  Если его не указать, результат может быть непредсказуемым.
  Сравнение с аналогами. В библиотеке есть и другие функции для работы с прямоугольниками: fillRect() (обычная заливка), 
  fillRoundRect() (заполненный прямоугольник с прямыми углами). fillSmoothRoundRect() — наиболее 
  продвинутый вариант для создания плавных интерфейсов.
  */

  // 1 вариант
  tft.fillScreen(TFT_BLACK); // clear the screen
  tft.fillRect(4, 0, 24, 208, TFT_WHITE);
  tft.drawSmoothRoundRect(0, 168, 8, 4, 32, 35, TFT_RED, TFT_WHITE);
  tft.fillSmoothRoundRect(0, 210, 32, 30, 4, TFT_YELLOW, TFT_BLACK);
  delay(2000);
  
  tft.fillScreen(TFT_BLACK); // clear the screen
  tft.fillRect(4, 0, 24, 208, TFT_WHITE);
  tft.drawSmoothRoundRect(0, 172, 8, 4, 32, 35, TFT_RED, TFT_WHITE);   // бегунок
  tft.fillSmoothRoundRect(0, 210, 32, 30, 4, TFT_YELLOW, TFT_BLACK);
  delay(5000);
  
  // 2 вариант
  tft.fillScreen(TFT_BLACK); // clear the screen
  tft.fillRect(2, 0, 12, 212, TFT_WHITE);
  tft.drawSmoothRoundRect(0, 182, 6, 3, 16, 25, TFT_RED, TFT_WHITE);   // бегунок
  tft.fillSmoothRoundRect(0, 214, 16, 22, 3, TFT_YELLOW, TFT_BLACK);
  delay(2000);
  
  tft.fillScreen(TFT_BLACK); // clear the screen
  tft.fillRect(2, 0, 12, 212, TFT_WHITE);
  tft.drawSmoothRoundRect(0, 186, 6, 3, 16, 25, TFT_RED, TFT_WHITE);
  tft.fillSmoothRoundRect(0, 214, 16, 22, 3, TFT_YELLOW, TFT_BLACK);
  delay(5000);
}
